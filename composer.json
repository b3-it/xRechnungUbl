{
    "name": "b3it/x-rechnung-ubl",
    "type": "library",
    "version": "1.0.0",
    "require": {
        "php": "^8.1",
        "ext-dom": "*",
        "ext-xml": "*",
        "ext-xsl": "*",
        "symfony/property-access": "^6.4 || ^7.1 || ^8.0",
        "symfony/property-info": "^6.4 || ^7.1 || ^8.0",
        "symfony/serializer": "^6.4 || ^7.1 || ^8.0",
        "phpdocumentor/reflection-docblock": "^5.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^12.0",
        "symfony/phpunit-bridge": "^6.4 || ^7.1 || ^8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "UBL\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UBL\\Tests\\": "tests/"
        }
    }
}
